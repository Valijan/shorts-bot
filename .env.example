# === Обязательно ===
BOT_TOKEN=123456:ABC-токен-от-BotFather
# Данные с my.telegram.org (нужны, чтобы бот принимал файлы до 2 ГБ)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
# Кто может пользоваться ботом (ID через запятую). Пусто = все.
ALLOWED_USERS=

# === ИИ-отбор моментов и перевод субтитров (необязательно) ===
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# === Распознавание речи ===
# tiny/base — быстро, small — баланс, medium — точнее (для узбекского лучше medium)
WHISPER_MODEL=small

# === Оформление ===
SHOW_TITLE=1
WATERMARK=
