# === Обязательно ===
BOT_TOKEN=123456:ABC-токен-от-BotFather
# Данные с my.telegram.org (нужны, чтобы бот принимал файлы до 2 ГБ)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
# Кто может пользоваться ботом (ID через запятую). Пусто = бот закрыт и только показывает твой ID.
ALLOWED_USERS=
# Открыть бота всем (не советую: тратится ключ Claude и время сервера)
PUBLIC_BOT=0

# === ИИ-отбор моментов и перевод субтитров (необязательно) ===
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# === Прямой эфир (/live) ===
# Длина куска записи, с: клип приходит примерно через столько после момента
LIVE_CHUNK=180
# Через сколько часов эфир остановится сам (страховка для баланса сервера)
LIVE_MAX_HOURS=3

# === Распознавание речи ===
# tiny/base — быстро, small — баланс, medium — точнее (для узбекского лучше medium)
WHISPER_MODEL=small

# === Оформление ===
SHOW_TITLE=1
WATERMARK=

# Файлы до 2 ГБ: свой сервер Bot API (https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
